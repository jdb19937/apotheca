OMNIA = crispus ddiff face ison insinulint munda phantasma sqrt sic delphi kadc

omnia:
	@for d in $(OMNIA); do $(FACE) -C $$d omnia APOTHECA=$(CURDIR); done

purga:
	@for d in $(OMNIA); do $(FACE) -C $$d purga APOTHECA=$(CURDIR); done

para:
	git submodule update --init

expara:
	git submodule deinit --all

trahe:
	@scripta/trahe.sh $(OMNIA)

firma:
	git submodule update

fige:
	@scripta/fige.sh $(OMNIA)

signa:
	@scripta/signa.sh $(TAG) $(OMNIA)

census:
	@scripta/census.sh $(OMNIA)

.PHONY: omnia purga omnia_purga trahe firma para expara fige signa census
