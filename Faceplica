NUDA = crispus ddiff face insinulint ison
OMNIA = $(NUDA) munda

omnia:
	@for d in $(NUDA); do $(FACE) -C $$d omnia; done
	$(FACE) -C munda omnia APOTHECA=$(CURDIR)

purga:
	@for d in $(NUDA); do $(FACE) -C $$d purga; done
	$(FACE) -C munda purga_omnia

para:
	git submodule update --init --recursive

expara:
	git submodule deinit --all

trahe:
	@scripta/trahe.sh $(OMNIA)

firma:
	git submodule update

fige:
	@scripta/fige.sh $(OMNIA)

signa:
	@scripta/signa.sh $(TAG) $(OMNIA)

census:
	@scripta/census.sh $(OMNIA)

.PHONY: omnia purga omnia_purga trahe firma para expara fige signa census
