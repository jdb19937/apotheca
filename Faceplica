OMNIA = face ison ddiff sic crispus insinulint phantasma munda sqrt delphi kadc xiterm vii ccc festum plus corpus plus homuncio proplasma solutus

omnia:
	@for d in $(OMNIA); do $(FACE) -C $$d omnia; done

colloca:
	@for d in $(OMNIA); do $(FACE) -C $$d colloca; done

decolloca:
	rm -rf /opt/apotheca

purga:
	@for d in $(OMNIA); do $(FACE) -C $$d purga; done

para:
	git submodule update --init

expara:
	git submodule deinit --all

trahe:
	@scripta/trahe.sh $(OMNIA)

firma:
	git submodule update

fige:
	@scripta/fige.sh $(OMNIA)

signa:
	@scripta/signa.sh $(TAG) $(OMNIA)

census:
	@scripta/census.py $(OMNIA)

.PHONY: omnia colloca purga omnia_purga trahe firma para expara fige signa census decolloca
